<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replacement for backup_rules. Same intent: keep prefs and
  the trip log across cloud-backup restore and device-to-device transfer,
  but exclude the secure-storage credentials blob.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="autologic_trips.db"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="autologic_trips.db"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
